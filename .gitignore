# Saídas dos comandos de auditoria/conciliação (--saida arquivo.txt).
# São diagnósticos descartáveis, refeitos a cada execução — nunca entregáveis.
# Se algum resultado precisar virar registro permanente, ele vai para docs/.
saida_*.txt
auditoria.csv
conciliacao_*.txt
# Lotes de execução do conciliar_dashboard_srp (a01.txt..a31.txt, lote_a.txt etc.)
a[0-9][0-9].txt
lote*.txt
# Despejos de depuração pontuais na raiz (dumps de fornecedor / itens / empenhos /
