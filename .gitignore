*_empenhos.txt
altacon*.txt
coinstel*.txt
multipar*.txt
radnor*.txt
fracao_*.txt
itens_[0-9]*.txt
map_[0-9]*.txt
sugestoes_*.txt

# Scripts de consulta ad-hoc criados durante investigações (scratch_*.py na raiz).
